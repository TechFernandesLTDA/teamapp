generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Board {
  id    String @id @default(cuid())
  slug  String @unique
  title String
  lists List[]
}

model Card {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  position    Float
  listId      String
  list        List      @relation(fields: [listId], references: [id], onDelete: Cascade)
  // GET /api/stats precisa de oldestCard/newestCard, e "mais antigo" so existe se
  // a linha souber quando nasceu. cuid() e ordenavel por tempo, mas so por acaso
  // de implementacao -- nao da para ordenar por ele e chamar de data.
  createdAt   DateTime  @default(now())
  // Lixeira: null = no board, timestamp = na lixeira. DELETE /api/cards/:id
  // marca; DELETE /api/trash/... e que apaga de verdade.
  deletedAt   DateTime?

  @@index([listId, position])
  @@index([deletedAt])
}

model List {
  id       String    @id @default(cuid())
  title    String
  position Float
  boardId  String
  board    Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards    Card[]
  // Lixeira. Mandar uma lista para a lixeira NAO marca os cards dela: eles somem
  // do board porque a lista sumiu, e voltam junto quando ela e restaurada. Marcar
  // em cascata ressuscitaria cards que ja tinham sido jogados fora sozinhos.
  deletedAt DateTime?

  @@index([boardId, position])
  @@index([deletedAt])
}

/// O Visualizador de Eventos do Windows 95: uma linha por mutacao, so texto ja
/// formatado. NAO ha FK para Card/List de proposito -- o log tem que sobreviver
/// ao "Esvaziar Lixeira", que apaga as linhas de verdade; um onDelete: Cascade
/// levaria junto exatamente o historico que se quer consultar depois.
model Activity {
  id        String   @id @default(cuid())
  type      String
  summary   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
