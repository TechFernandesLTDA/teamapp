# Variaveis do backend. Copie para `.env` (`cp .env.example .env`) antes de rodar
# fora do Docker. Os defaults abaixo sao os que estao no codigo -- ver
# backend/src/server.ts (PORT/HOST) e backend/prisma/schema.prisma (DATABASE_URL).

# Banco SQLite, lido por `env("DATABASE_URL")` no schema.prisma. Nao tem default
# no codigo: o Prisma falha na hora se a variavel estiver ausente.
# Caminho `file:` relativo e resolvido a partir de backend/prisma/, entao
# "file:./dev.db" e o arquivo backend/prisma/dev.db.
# No Docker o valor e absoluto e aponta para o volume nomeado: "file:/data/dev.db"
# (backend/Dockerfile e docker-compose.yml). Nunca aponte para um bind mount do
# Windows -- o file locking do SQLite falha de forma intermitente ali.
DATABASE_URL="file:./dev.db"

# Porta do processo Fastify: REST e WebSocket no mesmo listener.
# Default no codigo: 3001 (`Number(process.env.PORT ?? 3001)`).
PORT=3001

# Interface de bind. Default no codigo: 0.0.0.0 (`process.env.HOST ?? '0.0.0.0'`),
# que e o necessario dentro do container para a porta ser publicada no host.
# Em dev local, 127.0.0.1 basta.
HOST=0.0.0.0
