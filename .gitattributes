# Normaliza tudo para LF no repositorio, independente do SO de quem commita.
* text=auto eol=lf

# Fontes e configuracao: texto, sempre LF.
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.prisma text eol=lf
*.sql   text eol=lf
*.sh    text eol=lf
.gitignore      text eol=lf
.dockerignore   text eol=lf
.editorconfig   text eol=lf
Dockerfile      text eol=lf

# Binarios: o git nao mexe no conteudo nem tenta fazer diff.
*.png  binary
*.ico  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.woff  binary
*.woff2 binary
*.db   binary

# Lockfiles nao poluem o diff da revisao.
package-lock.json linguist-generated=true -diff
